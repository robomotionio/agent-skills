{
  "name": "@robomotion/app-kit",
  "version": "0.5.2",
  "description": "UI kit for Robomotion Apps: a design system of tokens, icons, motion and components, themed from app.json and painted the same in light and dark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/app-kit.css",
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.js",
      "require": "./dist/tailwind/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun scripts/gen-tokens.ts && tsup && bun scripts/check-browser-safe.ts && bun scripts/check-preset-free.ts",
    "typecheck": "tsc --noEmit",
    "check:browser": "bun scripts/check-browser-safe.ts",
    "check:preset-free": "bun scripts/check-preset-free.ts",
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "gen:icons": "bun scripts/sync-icons.ts",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@robomotion/apps-runtime": ">=0.1.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "@robomotion/apps-runtime": "file:../robomotion-apps-runtime"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.6",
    "@robomotion/apps-runtime": "file:../robomotion-apps-runtime",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "streamdown": "^2.6.0"
  }
}
